# URL pública do site (metadata, sitemap, robots — sem barra final)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Envio de leads: noop_preview (apenas log) | webhook (POST JSON)
LEAD_DISPATCH_MODE=noop_preview

# URL do webhook CRM (obrigatório se LEAD_DISPATCH_MODE=webhook)
# CRM_WEBHOOK_URL=https://...
# Hosts permitidos (obrigatório em produção com webhook) — vírgula
# CRM_WEBHOOK_ALLOWED_HOSTS=hooks.zapier.com,api.seucrm.com

# Cabeçalho opcional na requisição ao webhook (Bearer)
# CRM_API_KEY=

# Rate limit distribuído (recomendado em produção — Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Contato — WhatsApp (opcional; sobrescrito pelo painel /admin/contato quando salvo)
# NEXT_PUBLIC_CONTACT_WHATSAPP_DISPLAY=+55 (11) 99999-9999
# NEXT_PUBLIC_CONTACT_WHATSAPP_URL=https://wa.me/5511999999999

# CAPTCHA Cloudflare Turnstile (opcional, P1)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Painel admin interno (leads + textos de produtos) — obrigatório em produção
# ADMIN_PASSWORD=          # senha forte, diferente de admin123
# SESSION_SECRET=          # obrigatório em produção (string aleatória longa, independente da senha)

# URLs de acesso aos sistemas (montagem de subdomínio no admin /produtos)
NEXT_PUBLIC_APP_DOMAIN_PRODUCTION=paivatech.com.br
NEXT_PUBLIC_APP_DOMAIN_DEVELOPMENT=localhost:8000
# Força modo global para todas as landings: production | development
# NEXT_PUBLIC_FORCE_APP_ACCESS_MODE=development
# Hosts extras permitidos no redirect (vírgula)
# APP_REDIRECT_ALLOWED_HOSTS=nexshape.com.br,zyncora.com.br

# Portal Central — fallback da sidebar admin (sobrescrito por /admin/api/settings quando salvo)
# NEXT_PUBLIC_PORTAL_CENTRAL_URL=https://portal.seudominio.com.br
