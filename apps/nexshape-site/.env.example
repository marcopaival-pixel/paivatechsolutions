# URL pública do site (metadata, sitemap, robots — sem barra final)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Envio de leads: noop_preview (apenas log) | webhook (POST JSON)
LEAD_DISPATCH_MODE=noop_preview

# URL do webhook CRM (obrigatório se LEAD_DISPATCH_MODE=webhook)
# CRM_WEBHOOK_URL=https://...

# Cabeçalho opcional na requisição ao webhook (Bearer)
# CRM_API_KEY=

# Rate limit distribuído (recomendado em produção — Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Contato — WhatsApp (opcional)
# NEXT_PUBLIC_CONTACT_WHATSAPP_DISPLAY=+55 (11) 99999-9999
# NEXT_PUBLIC_CONTACT_WHATSAPP_URL=https://wa.me/5511999999999

# CAPTCHA Cloudflare Turnstile (opcional, P1)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
